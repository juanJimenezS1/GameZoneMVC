
@model IEnumerable<GameZoneMVC.Models.Videojuego>

@{
    ViewData["Title"] = "Catálogo de videojuegos";
}

<section class="game-hero rounded-4 p-4 p-md-5 mb-4">
    <div class="row align-items-center">
        <div class="col-md-8">
            <span class="badge text-bg-info mb-3">TU MUNDO GAMER</span>
            <h1 class="display-4 fw-bold">Bienvenido a GameZone</h1>
            <p class="lead">
                Descubre videojuegos, explora nuevos mundos y encuentra tu próxima aventura.
            </p>
            <a asp-controller="Videojuegos" asp-action="Crear"
               class="btn btn-info btn-lg fw-bold">
                Registrar videojuego
            </a>
        </div>
        <div class="col-md-4 text-center mt-4 mt-md-0">
            <div class="game-symbol">🎮</div>
            <h3>GameZone</h3>
            <p>Tu espacio gamer</p>
        </div>
    </div>
</section>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Catálogo de videojuegos</h2>
        <p class="text-secondary mb-0">Explora los juegos disponibles.</p>
    </div>

    <span class="badge rounded-pill text-bg-primary fs-6">
        @Model.Count() videojuegos
    </span>
</div>

<div class="row g-4">
    @foreach (var juego in Model)
    {
        <div class="col-sm-6 col-lg-4">
            <div class="card game-card h-100">
                <div class="game-card-top">
                    <span class="game-controller">🎮</span>
                </div>

                <div class="card-body d-flex flex-column">
                    <span class="badge game-badge align-self-start mb-2">
                        @juego.Genero
                    </span>

                    <h3 class="card-title h4 fw-bold">@juego.Nombre</h3>

                    <p class="text-secondary small mb-2">
                        Plataforma: @juego.Plataforma
                    </p>

                    <p class="card-text">@juego.Descripcion</p>

                    <div class="mt-auto pt-3">
                        <p class="game-price mb-0">
                            @(juego.Precio == 0
                                ? "Gratis"
                                : juego.Precio.ToString("C0",
                                    System.Globalization.CultureInfo.GetCultureInfo("es-CO")))
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="text-center mt-5 mb-3">
    <p class="text-secondary">
        GameZone MVC - Proyecto académico de Programación Web
    </p>
</div>
